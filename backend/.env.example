# Copy this file to .env and fill in the values
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=vulnsploit
# DB_USER=vulnsploit_user
# DB_PASSWORD=your-db-password
# DB_HOST=db
# DB_PORT=5432

CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

SCAN_RATE_LIMIT=20/h
LOGIN_RATE_LIMIT=10/15m

# ─── Scan safety ───────────────────────────────────────────────────────────────
# Targets must be proven (DNS TXT record or well-known file) before scanning.
# Keep True anywhere other than an isolated lab.
REQUIRE_TARGET_VERIFICATION=True
# How long a verification stays valid before it must be repeated.
TARGET_VERIFICATION_TTL_DAYS=90
# Lab only: allow targets/webhooks on loopback, private and link-local ranges.
# With this on, users can scan the server's own network. Never enable in production.
ALLOW_PRIVATE_TARGETS=False

# Gobuster wordlist path (inside container)
# GOBUSTER_WORDLIST=/usr/share/wordlists/common.txt

# ─── Object storage for PDF reports (S3 / R2 / MinIO) ──────────────────────────
# Leave all unset to use the local filesystem (MEDIA_ROOT). When
# AWS_STORAGE_BUCKET_NAME is set, django-storages uploads generated reports to
# the bucket via boto3 and the download endpoint redirects to a pre-signed URL.
# AWS_STORAGE_BUCKET_NAME=vulnsploit-reports
# AWS_S3_REGION_NAME=us-east-1
# AWS_S3_ENDPOINT_URL=                  # blank for AWS S3; set for R2/MinIO
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ─── Optional: NVD API key for higher CVE-enrichment rate limits ───────────────
# NVD_API_KEY=

# ─── Optional: live deployment URL (used for absolute links in emails) ─────────
# SITE_URL=https://vulnsploit.example.com
# DEFAULT_FROM_EMAIL=noreply@vulnsploit.com
